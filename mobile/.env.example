# Waivy iPhone app — optional build-time config (Expo inlines EXPO_PUBLIC_*).
# Everything also works without these (offline/local), and they can be set at
# runtime in the app's Settings instead.

# Cloudflare Worker that proxies OpenAI (recipe generation, images, pricing) and
# hosts cross-device sync. The OpenAI key stays on the Worker — never in the app.
EXPO_PUBLIC_WORKER_URL=

# Optional Anthropic Haiku key for fast on-device AI (pantry photo/paste parsing,
# the chat). Optional by design — the app degrades gracefully without it.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Optional USDA FoodData Central key for the Nourish food search (falls back to
# DEMO_KEY, then to custom foods + manual entry).
EXPO_PUBLIC_USDA_API_KEY=

# --- Accounts (Firebase Auth) — optional. Same project as the web app. -------
# When unset, all sign-in UI is hidden and the app works fully offline/local.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google sign-in on iOS — optional. Both must be set (and the app rebuilt
# with the iOS URL scheme in app.json) for the "Continue with Google" button to
# appear; otherwise it's hidden and email/password is the path. ---------------
# WEB client id: the OAuth "web" client Firebase made when you enabled Google.
#   Firebase console → Authentication → Sign-in method → Google → Web SDK config.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client id: from the iOS app's GoogleService-Info.plist (CLIENT_ID). Its
#   reversed form (REVERSED_CLIENT_ID) goes in app.json as the config-plugin
#   iosUrlScheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
